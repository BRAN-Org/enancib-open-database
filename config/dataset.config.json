{
  "organization": {
    "name": "BRAN Org",
    "url": "https://github.com/BRAN-Org",
    "logo": "https://avatars.githubusercontent.com/u/328064865?v=4",
    "institutionName": "BRAN Org",
    "githubUrl": "https://github.com/BRAN-Org/enancib-open-database",
    "doiUrl": "https://doi.org/10.5281/zenodo.23593583",
    "issuesUrl": "https://github.com/BRAN-Org/enancib-open-database/issues"
  },
  "dataset": {
    "title": "ENANCIB Open Database",
    "subtitle": "Acervo e Base de Dados Abertos",
    "description": "Base de dados bibliométrica aberta e acervo histórico completo dos 6.998 trabalhos científicos apresentados nos anais das 25 edições do Encontro Nacional de Pesquisa e Pós-Graduação em Ciência da Informação (ENANCIB, 1994–2026), principal conferência de Ciência da Informação no Brasil, disponibilizado pela BRAN Org sob princípios FAIR e BOAI.",
    "version": "2.0.0",
    "doi": "10.5281/zenodo.23593583",
    "license": "Code: GNU GPLv3 | Data: CC BY-NC-SA 4.0 (Não-Comercial & Sem Treino Comercial de IA)",
    "entityName": "articles",
    "singularName": "Artigo",
    "pluralName": "Artigos",
    "primaryKey": "id",
    "secondaryKey": "doi"
  },
  "schema": {
    "searchFields": [
      "title",
      "abstract",
      "authors",
      "keywords",
      "section",
      "issue",
      "tools",
      "data_sources",
      "usage_stages"
    ],
    "facets": [
      { "key": "year", "label": "Ano / Edição", "type": "number", "multi": true, "targetField": "year" },
      { "key": "section", "label": "Grupo de Trabalho (GT)", "type": "string", "targetField": "section" },
      { "key": "author", "label": "Autor / Pesquisador", "type": "string", "targetField": "authors" },
      { "key": "keyword", "label": "Palavra-chave / Tópico", "type": "string", "targetField": "keywords" },
      { "key": "tool", "label": "Ferramenta / Software", "type": "string", "targetField": "tools" },
      { "key": "source", "label": "Fonte de Dados", "type": "string", "targetField": "data_sources" },
      { "key": "stage", "label": "Etapa Metodológica", "type": "string", "targetField": "usage_stages" }
    ],
    "sortFields": [
      { "key": "year", "label": "Ano" },
      { "key": "title", "label": "Título" },
      { "key": "id", "label": "ID" }
    ]
  },
  "stats": {
    "topLists": [
      { "key": "topSections", "label": "Grupos de Trabalho (GTs) Mais Publicados", "sourceField": "section", "limit": 12 },
      { "key": "topAuthors", "label": "Autores Mais Frequentes", "sourceField": "authors", "limit": 10 },
      { "key": "topKeywords", "label": "Palavras-chave Mais Frequentes", "sourceField": "keywords", "limit": 10 },
      { "key": "topTools", "label": "Principais Softwares Utilizados", "sourceField": "tools", "limit": 10 },
      { "key": "topSources", "label": "Principais Fontes de Dados", "sourceField": "data_sources", "limit": 10 }
    ],
    "breakdowns": [
      { "key": "yearDistribution", "label": "Distribuição por Ano / Edição", "sourceField": "year" },
      { "key": "sectionBreakdown", "label": "Distribuição por Grupo de Trabalho", "sourceField": "section" }
    ]
  }
}
