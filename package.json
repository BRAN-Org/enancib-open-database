{
  "name": "enancib-open-database",
  "version": "1.0.0",
  "description": "Base de dados bibliométrica aberta e API REST pública dos anais do Encontro Nacional de Pesquisa e Pós-Graduação em Ciência da Informação (ENANCIB).",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/unit.test.js tests/api.test.js",
    "data:harvest": "python scripts/scrape_enancib.py",
    "data:convert": "node scripts/convert_csv_to_json.js",
    "data:validate": "node scripts/validate_dataset.js",
    "data:download-pdfs": "python scripts/download_pdfs.py",
    "init:event": "node scripts/init_event.js"
  },
  "keywords": [
    "open-data",
    "bran-org",
    "api",
    "academic-data",
    "enancib",
    "ancib",
    "ciencia-da-informacao",
    "bibliometrics",
    "scientometrics",
    "express"
  ],
  "author": "BRAN Org",
  "license": "GPL-3.0-or-later AND CC-BY-NC-SA-4.0",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.0.0"
  }
}
